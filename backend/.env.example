# ReconGuard backend configuration
# SQLite (default, zero-config). For PostgreSQL use:
#   RECONGUARD_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/reconguard
RECONGUARD_DATABASE_URL=sqlite:///./data/reconguard.db

# Accounting configuration (basis points; 100 bps = 1%)
RECONGUARD_GATEWAY_FEE_BPS=200
RECONGUARD_GST_ON_FEE_BPS=1800
RECONGUARD_TDS_BPS=10

# Reconciliation tolerances
RECONGUARD_ROUNDING_TOLERANCE_PAISA=1
RECONGUARD_SETTLEMENT_DATE_TOLERANCE_DAYS=3
RECONGUARD_EXPECTED_SETTLEMENT_LAG_DAYS=2

# AI layer is optional. The system is fully functional with this unset.
RECONGUARD_AI_PROVIDER=none
# For Gemini: RECONGUARD_AI_PROVIDER=gemini and GEMINI_API_KEY=your_key
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
